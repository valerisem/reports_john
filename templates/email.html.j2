{%- macro cell_label() -%}font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;{%- endmacro -%}
{%- macro rule(top=12) -%}<table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:{{ top }}px auto 0;"><tr><td width="48" height="4" bgcolor="#e91e8c" style="width:48px;height:4px;font-size:0;line-height:0;background-color:#e91e8c;background-image:linear-gradient(90deg,#e91e8c,#7c3aed);border-radius:4px;">&nbsp;</td></tr></table>{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light only">
<title>Sales pipeline update</title>
<style>
body{margin:0;padding:0;-webkit-text-size-adjust:100%;}
@media (max-width:620px){
 .pad{padding-left:20px!important;padding-right:20px!important;}
 .stack{display:block!important;width:100%!important;padding:0!important;}
 .gap{padding-top:32px!important;}
 .val{width:74px!important;}
 .dl{display:block!important;font-size:12px!important;}
 .lab{width:104px!important;}
 .sv{font-size:24px!important;line-height:28px!important;}
 .lab{width:110px!important;font-size:13px!important;}
 .hero{padding:130px 10px 0!important;}
 .sh{font-size:21px!important;line-height:26px!important;}
 .h1{font-size:28px!important;line-height:33px!important;}
}
</style>
</head>
<body style="margin:0;padding:0;background:#f4f3f7;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f3f7" style="background:#f4f3f7;">
<tr><td align="center" style="padding:24px 0;">
{%- if test_banner %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;"><tr><td style="padding:0 0 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fff4d6" style="background:#fff4d6;border-radius:8px;border:1px solid #f0d488;"><tr><td style="padding:14px 18px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:19px;color:#6b5412;">
<strong>TEST MODE</strong> — this message was redirected to you and was not sent to the real recipients.<br>
{% if test_banner.to %}When live it would go to <strong>{{ test_banner.to }}</strong>{% if test_banner.cc %}, cc <strong>{{ test_banner.cc }}</strong>{% endif %}.{% else %}No live recipients are set yet, so turning test mode off would not send this to anyone.{% endif %}
</td></tr></table>
</td></tr></table>
{%- endif %}
<!--[if mso]><table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f3f7" style="max-width:640px;background-color:#f4f3f7;background-image:url('{{ header_image_url }}');background-repeat:no-repeat;background-position:center top;background-size:100% auto;">
<tr><td class="hero"{% if footer_image_url %} background="{{ footer_image_url }}"{% endif %} style="padding:230px 20px {{ 300 if footer_image_url else 0 }}px;{% if footer_image_url %}background-image:url('{{ footer_image_url }}');background-repeat:no-repeat;background-position:center bottom;background-size:100% auto;{% endif %}">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="background:#ffffff;border-radius:10px;">
<tr><td class="pad" align="center" style="padding:38px 40px 0;">
<div class="h1" style="{{ cell_label() }}font-size:34px;line-height:39px;font-weight:700;color:#e91e8c;letter-spacing:-0.7px;">{{ title }}</div>
<div style="{{ cell_label() }}font-size:14px;line-height:20px;color:#6b6a75;padding-top:6px;">{{ report_date }}</div>
{{ rule(14) }}
</td></tr>
<tr><td class="pad" style="padding:30px 40px 0;">
<div style="{{ cell_label() }}font-size:16px;line-height:25px;color:#2b2a35;">Hi {{ greeting_name }}, here is the latest pipeline update. The full report is attached.</div>
</td></tr>

<tr><td class="pad" style="padding:28px 40px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #e7e5ec;border-bottom:1px solid #e7e5ec;"><tr><td style="padding:18px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{%- for stat in stats %}
<td class="st{{ loop.index0 }}" width="33%" align="center" valign="top" style="{% if not loop.first %}border-left:1px solid #e7e5ec;{% endif %}padding:2px 4px;text-align:center;"><div class="sv" style="{{ cell_label() }}font-size:32px;line-height:36px;font-weight:700;color:{{ stat.colour }};letter-spacing:-0.8px;">{{ stat.value }}</div><div style="{{ cell_label() }}font-size:14px;line-height:20px;color:#6b6a75;padding-top:2px;">{{ stat.label }}</div></td>
{%- endfor %}
</tr></table></td></tr></table></td></tr>

<tr><td class="pad" style="padding:52px 40px 0;"><div class="sh" style="{{ cell_label() }}font-size:24px;line-height:30px;font-weight:700;color:#15141f;letter-spacing:-0.3px;text-align:center;">Top brands by weighted value</div>
{{ rule() }}</td></tr>
<tr><td class="pad" style="padding:20px 40px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{%- for column in brand_columns %}
<td class="stack{% if not loop.first %} gap{% endif %}" width="50%" valign="top" style="padding-{% if loop.first %}right{% else %}left{% endif %}:14px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td colspan="2" style="padding:0 0 10px;{{ cell_label() }}font-size:15px;line-height:20px;font-weight:700;color:#e91e8c;">{{ column.heading }}</td></tr>
{%- if not column.brands and column.empty_note %}
<tr><td colspan="2" style="border-top:1px solid #e7e5ec;padding:14px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#6b6a75;">{{ column.empty_note }}</td></tr>
{%- endif %}
{%- for brand in column.brands %}
<tr><td valign="top" style="border-top:1px solid #e7e5ec;padding:10px 12px 10px 0;{{ cell_label() }}font-size:15px;line-height:21px;color:#15141f;">{% if brand.url %}<a href="{{ brand.url }}" style="color:#15141f;text-decoration:none;">{{ brand.name }}</a>{% else %}{{ brand.name }}{% endif %}{% if brand.poc %}<div style="{{ cell_label() }}font-size:13px;line-height:18px;color:#6b6a75;padding-top:1px;">POC: {{ brand.poc }}</div>{% endif %}</td><td align="right" valign="top" style="border-top:1px solid #e7e5ec;padding:10px 0;{{ cell_label() }}font-size:15px;line-height:21px;font-weight:700;color:#15141f;white-space:nowrap;">{{ brand.value }}</td></tr>
{%- endfor %}
{%- if column.extra_brands %}
<tr><td colspan="2" style="padding:22px 0 10px;{{ cell_label() }}font-size:15px;line-height:20px;font-weight:700;color:#e91e8c;">{{ column.extra_heading }}</td></tr>
{%- for brand in column.extra_brands %}
<tr><td valign="top" style="border-top:1px solid #e7e5ec;padding:10px 12px 10px 0;{{ cell_label() }}font-size:15px;line-height:21px;color:#15141f;">{% if brand.url %}<a href="{{ brand.url }}" style="color:#15141f;text-decoration:none;">{{ brand.name }}</a>{% else %}{{ brand.name }}{% endif %}{% if brand.poc %}<div style="{{ cell_label() }}font-size:13px;line-height:18px;color:#6b6a75;padding-top:1px;">POC: {{ brand.poc }}</div>{% endif %}</td><td align="right" valign="top" style="border-top:1px solid #e7e5ec;padding:10px 0;{{ cell_label() }}font-size:15px;line-height:21px;font-weight:700;color:#15141f;white-space:nowrap;">{{ brand.value }}</td></tr>
{%- endfor %}
{%- endif %}
</table></td>
{%- endfor %}
</tr></table></td></tr>
{%- if remaining_brands > 0 %}
<tr><td class="pad" style="padding:16px 40px 0;{{ cell_label() }}font-size:14px;line-height:20px;color:#6b6a75;">{{ remaining_brands }} more brand{{ 's' if remaining_brands != 1 else '' }} {{ 'are' if remaining_brands != 1 else 'is' }} in the pipeline. The full list is in the attached Excel file.</td></tr>
{%- endif %}

{%- if leaderboard.entries %}
<tr><td class="pad" style="padding:52px 40px 0;"><div class="sh" style="{{ cell_label() }}font-size:24px;line-height:30px;font-weight:700;color:#15141f;letter-spacing:-0.3px;text-align:center;">{{ leaderboard.heading }}</div>
{{ rule() }}</td></tr>
<tr><td class="pad" style="padding:26px 40px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{%- for entry in leaderboard.entries %}
<td width="33%" align="center" valign="bottom" style="padding:0 6px;text-align:center;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
{%- if entry.photo %}
<tr><td align="center" style="padding:0 0 4px;"><img src="{{ entry.photo }}" height="46" alt="{{ entry.name }}" style="display:block;height:46px;width:auto;border:0;margin:0 auto;"></td></tr>
{%- endif %}
<tr><td align="center" style="{{ cell_label() }}font-size:13px;line-height:17px;color:#2b2a35;">{{ entry.name }}</td></tr>
<tr><td align="center" style="{{ cell_label() }}font-size:19px;line-height:24px;font-weight:700;color:#15141f;letter-spacing:-0.3px;padding-top:2px;">{{ entry.value }}</td></tr>
<tr><td align="center" style="{{ cell_label() }}font-size:12px;line-height:16px;color:#6b6a75;">{{ entry.deals }} deal{{ 's' if entry.deals != 1 else '' }}</td></tr>
<tr><td align="center" style="padding-top:10px;"><table role="presentation" width="56" cellpadding="0" cellspacing="0" border="0" align="center" style="width:56px;margin:0 auto;"><tr><td width="56" height="{{ entry.height }}" bgcolor="{{ entry.colour }}" align="center" valign="top" style="width:56px;height:{{ entry.height }}px;background-color:{{ entry.colour }};padding-top:10px;{{ cell_label() }}font-size:18px;line-height:22px;font-weight:700;color:{{ entry.numeral_colour }};">{{ entry.rank }}</td></tr></table></td></tr>
</table>
</td>
{%- endfor %}
</tr></table></td></tr>
{%- endif %}

{%- for section in bar_sections %}
<tr><td class="pad" style="padding:52px 40px 0;"><div class="sh" style="{{ cell_label() }}font-size:24px;line-height:30px;font-weight:700;color:#15141f;letter-spacing:-0.3px;text-align:center;">{{ section.heading }}</div>
{{ rule() }}{% if section.subtitle %}<div style="{{ cell_label() }}font-size:14px;line-height:20px;color:#6b6a75;padding-top:12px;text-align:center;">{{ section.subtitle }}</div>{% endif %}</td></tr>
<tr><td class="pad" style="padding:18px 40px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{%- for row in section.rows %}
<tr><td class="lab" width="150" valign="middle" align="right" style="padding:4px 12px 4px 0;{{ cell_label() }}font-size:14px;line-height:18px;color:#2b2a35;">{{ row.label }}</td>
<td valign="middle" style="padding:4px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{%- if row.segments %}{% set filled = row.segments | sum(attribute='percent') %}
{%- for seg in row.segments %}<td width="{{ seg.percent }}%" height="16" bgcolor="{{ seg.colour }}" style="width:{{ seg.percent }}%;height:16px;background-color:{{ seg.colour }};font-size:0;line-height:0;">&nbsp;</td>{% endfor %}
{%- if filled < 100 %}<td width="{{ 100 - filled }}%" style="font-size:0;line-height:0;">&nbsp;</td>{% endif %}
{%- else %}<td width="{{ row.percent }}%" height="16" bgcolor="{{ section.colour }}" style="background-color:{{ section.colour }};height:16px;font-size:0;line-height:0;">&nbsp;</td>{% if row.percent < 100 %}<td width="{{ 100 - row.percent }}%" style="font-size:0;line-height:0;">&nbsp;</td>{% endif %}
{%- endif %}
</tr></table></td>
<td class="val" width="128" valign="middle" style="padding:4px 0 4px 10px;{{ cell_label() }}font-size:14px;line-height:18px;font-weight:700;color:#15141f;white-space:nowrap;">{{ row.value }}<span class="dl" style="font-weight:400;color:#6b6a75;">&nbsp;&nbsp;{{ row.deals }} deal{{ 's' if row.deals != 1 else '' }}</span></td></tr>
{%- endfor %}
</table></td></tr>
{%- endfor %}

<tr><td class="pad" style="padding:40px 40px {{ 18 if footer_image_url else 36 }}px;{{ cell_label() }}font-size:16px;line-height:24px;color:#2b2a35;">Kindly,<br><span style="font-weight:700;color:#15141f;">{{ sender_name }}</span></td></tr>

</table>
{%- if not footer_image_url %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" style="padding:32px 0 36px;"><img src="{{ logo_url }}" width="60" height="55" alt="House of Marketers" style="display:block;border:0;width:60px;height:55px;margin:0 auto;"></td></tr></table>
{%- endif %}
</td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr></table>
</body>
</html>
