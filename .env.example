# ---------------------------------------------------------------------------
# Pipedrive
# ---------------------------------------------------------------------------
# Personal API token: Pipedrive > Settings > Personal preferences > API
PIPEDRIVE_API_TOKEN=
# Company subdomain, e.g. "houseofmarketers" for houseofmarketers.pipedrive.com.
# Leave as "api" if you are unsure - it works for most accounts.
PIPEDRIVE_DOMAIN=api
# Which pipeline to report on. 1 is the default sales pipeline.
PIPEDRIVE_PIPELINE_ID=1

# Custom fields are matched by display name. Override with a field key (the
# 40-character value from GET /preview/fields) if a field is named unusually.
# In this account Industry lives in "Wide niche" and Sub-industry in
# "Narrow niche" - both are matched automatically.
PIPEDRIVE_FIELD_ACCOUNT_MANAGER=
PIPEDRIVE_FIELD_INDUSTRY=
PIPEDRIVE_FIELD_SUB_INDUSTRY=

# ---------------------------------------------------------------------------
# Supabase - the team directory (pods, account owners, account managers)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://tciqyupqtpbhremuprxe.supabase.co
# The anon / publishable key is enough. team, roles and teams allow public
# reads and account_manager_orgs has no RLS, so no service-role key is needed.
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------
REPORT_TITLE=Sales Pipeline Update
REPORT_GREETING_NAME=John
REPORT_SENDER_NAME=Valeria
REPORT_TIMEZONE=Europe/London

# Header artwork and logo. The header's filler colour must match the email
# background (#f4f3f7) or a seam shows in the strips beside the white card.
HEADER_IMAGE_URL=
# Mirrors the header: the background fades down into the photo so the email
# ends on the picture. Leave empty for a plain logo footer.
FOOTER_IMAGE_URL=
LOGO_URL=
# Base URL for the leaderboard head shots, one PNG per account owner named
# owner-<first name>.png, e.g. owner-valeriia.png. Blank hides the pictures.
OWNER_PHOTO_BASE_URL=

# Live rates are fetched each run; these are only used if that lookup fails.
FX_FALLBACK_USD_GBP=0.74
FX_FALLBACK_EUR_GBP=0.85

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
MAIL_FROM=you@yourcompany.com
MAIL_FROM_NAME=House of Marketers
MAIL_TO=john@example.com
MAIL_CC=
MAIL_SUBJECT_TEMPLATE=Sales Pipeline Update - {date}

# TEST_MODE=true redirects every send to TEST_RECIPIENT and prefixes the
# subject with [TEST]. Flip to false only when you are happy with the output.
TEST_MODE=true
TEST_RECIPIENT=you@yourcompany.com

# ---------------------------------------------------------------------------
# Gmail
# ---------------------------------------------------------------------------
# "app_password" (simplest - nothing to register) or "oauth".
MAIL_TRANSPORT=app_password

# App Password route: https://myaccount.google.com/apppasswords
# Needs 2-Step Verification on the account. Paste the 16 characters; spaces are
# stripped automatically. Gmail copies SMTP-sent mail into Sent by itself.
GMAIL_APP_PASSWORD=

# OAuth route only (MAIL_TRANSPORT=oauth) - use if your Workspace admin has
# disabled App Passwords. Run `python scripts/gmail_oauth.py` to mint these.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Schedule (off until you pick a cadence)
# ---------------------------------------------------------------------------
SCHEDULE_ENABLED=false
# 5-field cron, evaluated in REPORT_TIMEZONE.
SCHEDULE_CRON=0 9 * * WED
SCHEDULE_FORTNIGHTLY=true
# A date in a week the report SHOULD go out; parity is measured from it.
SCHEDULE_ANCHOR_DATE=2026-09-16

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Required header X-Admin-Token on /preview/* and /run. Leave blank to disable.
ADMIN_TOKEN=
